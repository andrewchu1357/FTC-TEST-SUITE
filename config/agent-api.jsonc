// The agent API: lets AI agents (Claude Code, Cursor, Codex, any MCP client) drive the simulator
// to test team code and new mechanisms. Guide: docs/agent-api.md
//
// The headless server (tools/ftc-sim-mcp) always works, without the window. These settings are for
// the server inside the app, which also gives agents the window's own simulation ("live"):
// it listens on this computer only (127.0.0.1), needs a token (File > Copy Agent Connection copies
// a ready-made command with it), and refuses requests from web pages.
{
  "enabled": true,
  "port": 8767,

  // Leave empty to use a random token made for this computer's user (tools/ftc-sim-mcp --live
  // finds it by itself). Set one here to share it with another program.
  "token": "",

  // Files agents can read but not change (globs relative to the project). Clones of a team's own
  // repository stay as they are: agents test changes to that code by passing the changed files
  // to sim_create / compile_code as "sources" instead.
  "readOnly": ["robots/*/repo/**"],

  // java_eval runs Java an agent writes inside the simulator (full access to the simulation and
  // the team code). Turn it off to allow only the other tools.
  "javaEval": true
}
